rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each family's data sits under its secret 12-character family code.
    // A device must know the code to reach a family; nobody can list all families.
    match /families/{code} {
      allow get, create, update: if request.auth != null && code.size() == 12;
      allow list, delete: if false;
      match /{rest=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
